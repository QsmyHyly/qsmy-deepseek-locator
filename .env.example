# ===== 复制为 .env 或直接设成系统环境变量 =====
# 只列本库真正读取的变量；没有 .env 解析依赖，
# 想用 .env 就在自己的启动脚本里加载它（库本身不读文件、只读环境变量）。

# API Key（必填；缺失时本地调用会直接报 MissingAPIKeyError，不会静默兜底）
DEEPSEEK_API_KEY=

# 接口地址。指向任意 OpenAI 兼容服务也行（本库只用 chat/completions 一条路）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名。deepseek-flash 就是 DeepSeek-V4.1-Flash；
# 官方另一档 deepseek-v4-pro 不支持图像理解，换成它识别链路直接失效。
DEEPSEEK_MODEL=deepseek-flash

# 单次请求超时（秒）与 SDK 自动重试次数
QSML_TIMEOUT=120
QSML_MAX_RETRIES=2

# 思考模式默认开关：留空 = 不显式传，由服务端决定（当前默认开启）。
# 1 = 强制开启，0 = 强制关闭（更快更省 token，坐标类任务实测不掉准确率）
QSML_THINKING=

# 思考强度：low / medium / high / xhigh / max，留空 = 不传（服务端按 high）
QSML_REASONING_EFFORT=

# image_url 的 detail：low / high / original / auto，留空 = 不发送该字段
# 注意它不是「提高定位精度」的开关：每张图服务端最多只算 384 token
QSML_IMAGE_DETAIL=

# 输出上限（含思考 token）。留空 = 不传，用服务端默认。
# 若遇到「content 为空」的报错，多半是思考吃光了预算，调大它或关掉思考。
QSML_MAX_TOKENS=

# 覆盖系统提示词（承载坐标口径，改之前先读 prompts.py 的注释）
QSML_SYSTEM_PROMPT=
